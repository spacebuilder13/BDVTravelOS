# Public URL of the backend API (no trailing slash)
REACT_APP_BACKEND_URL=http://localhost:8000


# Carto basemap key for the Trip Planner route map (PlannerMap.jsx).
# Browser-exposed at build time: set it in Vercel env vars (Production + Preview) and redeploy. Never commit a real key.
REACT_APP_CARTO_API_KEY=your-carto-api-key
