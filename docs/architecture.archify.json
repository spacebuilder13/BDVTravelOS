  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "PIN login → 24h HS256 JWT, kept in localStorage, sent as Bearer",
        "get_current_user re-reads the staff doc on every call",
        "Handlers hit Mongo via Motor; AI routes stream through LlmChat"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Browser is untrusted; Vercel only serves static files",
        "One JWT gate; admin checks are inline role comparisons",
        "/api/uploads is a static mount, readable without a JWT"
      ]
    },
    {
      "dot": "amber",
      "title": "Watch-outs",
      "items": [
        "JWT_SECRET and CORS_ORIGINS have unsafe code defaults",
        "URL extract fetches any staff URL server-side (SSRF)",
        "Uploads need the Railway volume; seed admins use PIN 0000"
      ]
    }
  ]
