  "cards": [
    {
      "dot": "cyan",
      "title": "Standard round trip",
      "items": [
        "axios sends Bearer JWT; 401 → /login",
        "Guard re-reads db.staff every call",
        "serialize_doc drops _id, ISO dates"
      ]
    },
    {
      "dot": "violet",
      "title": "Where Claude sits",
      "items": [
        "Behind the JWT guard, in handlers only",
        "Only chat streams; others await reply",
        "One LlmChat shim, one LLM_API_KEY"
      ]
    },
    {
      "dot": "emerald",
      "title": "What gets persisted",
      "items": [
        "User msg saved first, reply after",
        "ai-generate saves nothing itself",
        "Stream errors arrive as SSE events"
      ]
    }
  ]
