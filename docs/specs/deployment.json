  "cards": [
    {
      "dot": "rose",
      "title": "Cross-domain auth",
      "items": [
        "bdvv_token cookie needs samesite=\"none\"; secure=True — Vercel and Railway are different domains",
        "get_current_user tries Authorization: Bearer first, then the cookie — fixed a same-site logout bug",
        "CORS_ORIGINS must be updated whenever the Vercel URL changes, or requests get blocked"
      ]
    },
    {
      "dot": "cyan",
      "title": "Anthropic call sites",
      "items": [
        "compass_chat, link-extraction, ai_generate_itinerary — all via a local LlmChat shim, model claude-sonnet-5",
        "The shim calls the anthropic SDK directly with LLM_API_KEY"
      ]
    },
    {
      "dot": "slate",
      "title": "/prod split — planned, not built",
      "items": [
        "One deployment today; no demo/prod separation",
        "Next: separate Railway + Vercel envs, each with its own Mongo + CORS_ORIGINS",
        "Distinct from the also-pending Postgres/Supabase migration"
      ]
    }
  ]
