  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend (Vercel)",
      "items": [
        "CRA/craco build, root directory frontend/",
        "REACT_APP_BACKEND_URL must point at the deployed backend, no trailing slash",
        "CORS_ORIGINS on Railway must be updated whenever the Vercel URL changes, or the frontend gets CORS errors",
        "The page shell loads no third-party builder script; the title is \"BDV TravelOS\""
      ]
    },
    {
      "dot": "violet",
      "title": "Auth: cross-domain JWT",
      "items": [
        "JWT issued on login, stored as httpOnly cookie bdvv_token",
        "Bearer header fallback because Vercel + Railway are different domains (third-party cookie issues in Safari / private browsing)",
        "get_current_user tries the Authorization header first, then falls back to the cookie"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend (Railway)",
      "items": [
        "Entire API lives in one file, backend/server.py (~5,700 lines)",
        "All routes mounted under /api via api_router",
        "Started via uvicorn per backend/Procfile"
      ]
    },
    {
      "dot": "amber",
      "title": "Data & file storage",
      "items": [
        "MongoDB via Motor — collections are plain dicts, no ORM/schema layer",
        "Enquiry PDFs and itinerary images written to local disk under backend/uploads/",
        "Requires a persistent volume mount on the Railway backend service — if uploads disappear after a deploy, check the volume mount first"
      ]
    },
    {
      "dot": "rose",
      "title": "Compass AI (Anthropic)",
      "items": [
        "Local LlmChat / UserMessage / FileContent shim calls the anthropic SDK directly",
        "Three call sites: compass_chat, the link-extraction endpoint, and ai_generate_itinerary",
        "Model ID is claude-sonnet-5"
      ]
    },
    {
      "dot": "slate",
      "title": "Known limitations / next phase",
      "items": [
        "Database is MongoDB, not Postgres — Supabase migration is a planned but not-yet-started later phase",
        "No demo/prod environment separation — one deployment, one Mongo database",
        "Uploads are local-disk, not object storage (S3 / Supabase Storage) — fine while Railway's volume persists"
      ]
    }
  ]
}
