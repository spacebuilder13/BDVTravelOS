# MongoDB connection string (Railway MongoDB service connection URI)
MONGO_URL=mongodb://user:password@host:port
DB_NAME=bdv_travel_os

# Secret used to sign auth JWTs — generate a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# Anthropic API key, used by the Compass AI Assistant / itinerary AI features
# (passed through emergentintegrations' LlmChat with provider "anthropic")
LLM_API_KEY=
